rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: only authenticated user can read/write their own doc
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Tools subcollection: user can read/write their own tools
      match /tools/{toolId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
